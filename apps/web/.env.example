# Copia este archivo como .env.local y rellena los valores de TU proyecto de Supabase
# (Supabase → Project Settings → API). Ver docs/nube.md.
# Sin estas variables la app funciona igual, guardando todo en el navegador.

# Dirección del proyecto, por ejemplo https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública "anon" (o "publishable"). Es pública a propósito: los permisos los ponen las reglas de acceso.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio ("service_role" o "secret"). SOLO servidor: sirve para borrar cuentas.
# Nunca la pongas con NEXT_PUBLIC_ delante ni la subas a GitHub.
SUPABASE_SERVICE_ROLE_KEY=
